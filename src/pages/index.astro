---
import Layout from '../layouts/Layout.astro';
import PortalCard from '../components/PortalCard.astro';

const portals = [
  {
    title: 'Dramain',
    description: 'Portal khusus Drama Korea, China, & Jepang. Nikmati ribuan judul dengan subtitle Indonesia.',
    url: 'https://dramain.nontonin.site',
    delay: '0.4s',
    themeColor: '#eab308',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 3L5 7H19L17 3H7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 7V21H22V7H2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 12L15 15L10 18V12Z" fill="currentColor"/></svg>'
  },
  {
    title: 'Animein',
    description: 'Gerbang utama koleksi Anime terlengkap. Update harian dengan kualitas simulcast HD.',
    url: 'https://animein.nontonin.site',
    delay: '0.5s',
    themeColor: '#3b82f6',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
  },
  {
    title: 'Moviein',
    description: 'Portal Film Box Office & Indonesia. Akses cepat ke koleksi sinema terbaik dari seluruh dunia.',
    url: 'https://moviein.nontonin.site',
    delay: '0.6s',
    themeColor: '#ef4444',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="3" width="20" height="18" rx="2" stroke="currentColor" stroke-width="2"/><path d="M7 3V21" stroke="currentColor" stroke-width="2"/><path d="M17 3V21" stroke="currentColor" stroke-width="2"/><path d="M2 8H7" stroke="currentColor" stroke-width="2"/><path d="M17 8H22" stroke="currentColor" stroke-width="2"/><path d="M2 16H7" stroke="currentColor" stroke-width="2"/><path d="M17 16H22" stroke="currentColor" stroke-width="2"/></svg>'
  }
];
---

<Layout title="Nontonin — Universal Streaming Portal">
	<main>
    <!-- Background Decor -->
    <div class="background-system">
      <div class="glow-top"></div>
      <div class="mesh-gradient"></div>
      <div class="grid-overlay"></div>
    </div>

    <nav class="nav reveal">
      <div class="container nav-inner">
        <div class="nav-links hide-mobile">
        </div>
      </div>
    </nav>

    <section class="hero">
      <div class="container">
        <div class="hero-header reveal delay-1">
          <div class="shimmer-wrapper">
            <h1 class="shimmer-text">NONTONIN</h1>
          </div>
          <p class="hero-desc">
            Satu tempat untuk akses semua tontonan favoritmu. Pilih portal di bawah untuk mulai nonton film, drama, atau anime secara gratis.
          </p>
          
          <div class="network-stats">
            <div class="stat-item">
              <span class="stat-value">3</span>
              <span class="stat-label">Pilihan Portal</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-value">HD</span>
              <span class="stat-label">Kualitas Video</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat-item">
              <span class="stat-value">FREE</span>
              <span class="stat-label">Biaya Langganan</span>
            </div>
          </div>
        </div>

        <div class="portals-section">
          <div class="section-label reveal delay-2">AVAILABLE GATEWAYS</div>
          <div class="portals-grid">
            {portals.map((portal) => (
              <PortalCard {...portal} />
            ))}
          </div>
        </div>
      </div>
    </section>

    <footer class="footer reveal delay-5">
      <div class="container">
         <div class="footer-content">
           <div class="footer-line"></div>
           <div class="footer-bottom">
             <p>© 2026 @Nontonin. Seluruh hak cipta dilindungi.</p>
             <div class="footer-meta hide-mobile">PORTAL VERSION 2.0.4 // ENCRYPTED ACCESS</div>
           </div>
         </div>
      </div>
    </footer>
	</main>
</Layout>

<script>
  // Intersection Observer for Scroll Animations
  const observerOptions = {
    root: null,
    rootMargin: '-30% 0px -30% 0px', // Focus on middle 40% of screen
    threshold: 0.5
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-active');
      } else {
        entry.target.classList.remove('is-active');
      }
    });
  }, observerOptions);

  // Re-run observer when content changes (useful with Astro ViewTransitions)
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll('.portal-card');
    cards.forEach(card => observer.observe(card));
  });

  // Initial run
  const cards = document.querySelectorAll('.portal-card');
  cards.forEach(card => observer.observe(card));
</script>

<style>
  main {
    min-height: 100vh;
    position: relative;
    padding-bottom: 4rem;
  }

  .background-system {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .glow-top {
    position: absolute;
    top: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 50%;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  .mesh-gradient {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(at 0% 0%, hsla(253,16%,7%,1) 0, transparent 50%), 
      radial-gradient(at 50% 10%, hsla(225,39%,30%,0.08) 0, transparent 50%), 
      radial-gradient(at 100% 0%, hsla(339,49%,30%,0.08) 0, transparent 50%);
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 50px 50px;
    mask-image: radial-gradient(ellipse at center, black, transparent 80%);
    opacity: 0.15;
  }

  .nav {
    height: 100px;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    background: white;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(-10deg);
  }

  .logo-text {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 2px;
    color: white;
  }
  
  .logo-text span {
    color: var(--fg-subtle);
    font-weight: 400;
    font-size: 0.75rem;
    margin-left: 4px;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: monospace;
    font-size: 0.65rem;
    letter-spacing: 1px;
    color: var(--fg-subtle);
    background: rgba(255,255,255,0.03);
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .status-indicator .dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  .hero {
    padding: 2rem 0 6rem;
    position: relative;
    z-index: 1;
  }

  .hero-header {
    margin-bottom: 5rem;
    max-width: 800px;
  }

  .portal-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: var(--fg-muted);
  }

  .shimmer-wrapper {
    perspective: 1000px;
    margin-bottom: 0.5rem;
    padding: 0;
  }

  h1.shimmer-text {
    font-size: clamp(3.5rem, 15vw, 9rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.06em;
    margin-bottom: 0;
    position: relative;
    display: block;
    width: fit-content;
    
    /* Solid base color with shimmer overlay */
    background: linear-gradient(
      120deg, 
      #ffffff 25%, 
      #71717a 50%, 
      #ffffff 75%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    
    animation: 
      shimmer 5s linear infinite, 
      float 6s ease-in-out infinite;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  @keyframes shimmer {
    to {
      background-position: 200% center;
    }
  }

  @keyframes float {
    0%, 100% {
      transform: rotateX(5deg) rotateY(-5deg) translateY(0);
    }
    50% {
      transform: rotateX(-5deg) rotateY(5deg) translateY(-10px);
    }
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--fg-muted);
    max-width: 550px;
    line-height: 1.7;
    margin-bottom: 3rem;
  }

  .hero-desc strong {
    color: white;
    font-weight: 600;
  }

  .network-stats {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 2rem;
    margin-top: 2rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: white;
    font-family: 'Outfit', sans-serif;
  }

  .stat-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--fg-subtle);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border);
  }

  .section-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 4px;
    color: var(--fg-subtle);
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-label::after {
    content: '';
    height: 1px;
    flex-grow: 1;
    background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
  }

  .portals-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .footer {
    margin-top: 6rem;
  }

  .footer-line {
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--border) 0%, transparent 100%);
    margin-bottom: 2rem;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer p {
    font-size: 0.8rem;
    color: var(--fg-subtle);
  }

  .footer-meta {
    font-family: monospace;
    font-size: 0.65rem;
    color: var(--fg-subtle);
    letter-spacing: 1px;
  }

  @media (max-width: 1024px) {
    .portals-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: 1rem;
    }
    
    .hero-header {
      margin-bottom: 3.5rem;
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    h1.shimmer-text {
      font-size: 3.5rem;
      margin: 0 auto;
    }

    .shimmer-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 0.5rem;
    }

    .hero-desc {
      font-size: 1rem;
      margin: 0 auto 2rem;
    }

    .network-stats {
      justify-content: center;
      gap: 1.5rem;
    }

    .stat-value {
      font-size: 1.1rem;
    }

    .stat-label {
      font-size: 0.55rem;
    }

    .stat-divider {
      height: 30px;
    }

    .portals-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .nav {
       height: 80px;
    }
    
    .section-label {
      font-size: 0.65rem;
      letter-spacing: 3px;
    }
  }
</style>
